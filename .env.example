# Supabase Postgres の接続先。
# DATABASE_URL はアプリ実行用。Supabase の Transaction pooler URL を指定する。
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL は Prisma migrate 用。Supabase の Direct connection URL を指定する。
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth 用。Project Settings > API から取得する。
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"

# 試験運用のデフォルト店舗。将来はログイン/店舗選択で切り替える。
DEFAULT_STORE_SLUG="mt-sheridan"
DEFAULT_STORE_NAME="MT SHERIDAN"
DEFAULT_STORE_TIMEZONE="Australia/Brisbane"

# Store.settingsPasswordHash が未設定の店舗で使う初期Settingsパスワード。
# 試験運用では 0000 のままでも動くが、本番では必ず変更する。
SETTINGS_DEFAULT_PASSWORD="0000"

# Settings解除Cookieの署名用。未指定時はDB接続文字列を代用する。
SETTINGS_UNLOCK_SECRET="change-this-random-secret"

# 初期データ登録時に、このメールアドレスをデフォルト店舗の OWNER として紐づける。
# Supabase Auth 連携後は、このメールのユーザーでログインできるようにする想定。
DEFAULT_OWNER_EMAIL="owner@example.com"
