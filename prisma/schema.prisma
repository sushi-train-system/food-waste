// 寿司屋 廃棄管理システム - Prisma スキーマ
// Supabase Postgres を想定。店舗ごとにデータを分離できる構成。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 店舗。試験運用では DEFAULT_STORE_SLUG の1店舗を利用し、将来は店舗を追加する。
model Store {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  timezone   String       @default("Australia/Brisbane")
  categories Category[]
  items      MenuItem[]
  entries    WasteEntry[]
  createdAt  DateTime     @default(now())
}

/// メニューのジャンル（にぎり / ロール など）。入力タブのサブタブに対応。
model Category {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug      String // nigiri, roll, gunkan ...
  name      String // 表示名（にぎり など）
  sortOrder Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())

  @@unique([storeId, slug])
  @@index([storeId])
}

/// 個々のメニュー（マグロ、サーモン など）
model MenuItem {
  id         String       @id @default(cuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  priceAud   Float        @default(5) // 単価（AUD）。廃棄額 = quantity × priceAud
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  active     Boolean      @default(true)
  entries    WasteEntry[]
  createdAt  DateTime     @default(now())

  @@index([storeId])
  @@index([categoryId])
}

/// 2時間ごとの廃棄数入力レコード（生データ）
/// slot は営業時間帯の開始時刻(hour)。例: 10,12,14,16,18,20
model WasteEntry {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD（店舗ローカル日付）
  slot       Int // 2時間スロットの開始時刻(hour)
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, menuItemId, date, slot])
  @@index([storeId, date])
}
